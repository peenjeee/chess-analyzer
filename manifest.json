{
  "manifest_version": 3,
  "name": "Chess Analyzer",
  "version": "2.3",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "description": "A minimalist, hyper-optimized chess analyzer.",
  "host_permissions": [
    "https://chess.0xpnj.dev/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "js": ["scripts/main.js"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*"
      ]
    }
  ]
}