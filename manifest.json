{
  "manifest_version": 3,
  "name": "Chess Analyzer",
  "version": "3.3",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "description": "A minimalist, hyper-optimized chess analyzer.",
  "permissions": ["offscreen"],
  "host_permissions": [
    "https://chess.0xpnj.dev/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "js": ["scripts/main.js"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://endgame.ai/*",
        "https://www.endgame.ai/*"
      ]
    }
  ]
}
